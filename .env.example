# Credenciais do administrador. Configure estes valores na VPS.
AUTH_EMAIL=seu-email@empresa.com.br
AUTH_PASSWORD_HASH=pbkdf2-sha256$210000$salt$hash

# Use uma chave aleatória com pelo menos 32 caracteres.
# Exemplo para gerar: openssl rand -base64 48
AUTH_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# URL pública usada pelo túnel Cloudflare para validar requisições autenticadas.
APP_ORIGIN=https://mapaparque.consultaa7.com.br

# Banco persistente local da VPS. Monte um volume permanente neste diretório.
DATABASE_PATH=/var/lib/mapa-parque/mapa-parque.sqlite

# Arquivos recebidos e snapshots usados pelos processadores.
UPLOAD_PATH=/var/lib/mapa-parque/uploads

# Porta interna da aplicação na VPS.
PORT=8000
